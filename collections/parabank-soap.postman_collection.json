{
  "info": {
    "_postman_id": "0554a3a5-a654-5c9e-ac76-ed2bd97d217d",
    "name": "ParaBank SOAP",
    "description": "Те же операции через SOAP-сервис ParaBank (WSDL: {{baseUrl}}/services/ParaBank?wsdl).\nТела запросов — по WSDL: элементы в пространстве имён сервиса, иначе сервис отвечает\nUnmarshalling Error. Ответы разбираются как XML, а не поиском подстроки.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Новый клиент",
      "item": [
        {
          "name": "Форма регистрации",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "2783b42b-4ea0-5752-b022-56843b56cb7d",
                "type": "text/javascript",
                "exec": [
                  "// Уникальный логин: ParaBank не даёт удалить клиента, повтор логина — ошибка регистрации.",
                  "pm.collectionVariables.set('username', 'qa' + Date.now().toString(36) + Math.floor(Math.random() * 1e4));",
                  "pm.collectionVariables.set('password', 'Pw' + Math.floor(Math.random() * 1e8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "b9f17f76-3d4b-5628-b3d0-8d4da70986b9",
                "type": "text/javascript",
                "exec": [
                  "pm.test('форма открывается', () => pm.response.to.have.status(200));",
                  "pm.test('сессия выдана', () => pm.expect(pm.cookies.has('JSESSIONID')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/register.htm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register.htm"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Регистрация",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "213c181b-1a04-55dd-96f8-2a5a7bf18b5b",
                "type": "text/javascript",
                "exec": [
                  "pm.test('клиент зарегистрирован', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('Welcome ' + pm.collectionVariables.get('username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/register.htm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register.htm"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "customer.firstName",
                  "value": "Anna",
                  "type": "text"
                },
                {
                  "key": "customer.lastName",
                  "value": "Petrova",
                  "type": "text"
                },
                {
                  "key": "customer.address.street",
                  "value": "Tverskaya 1",
                  "type": "text"
                },
                {
                  "key": "customer.address.city",
                  "value": "Moscow",
                  "type": "text"
                },
                {
                  "key": "customer.address.state",
                  "value": "MSK",
                  "type": "text"
                },
                {
                  "key": "customer.address.zipCode",
                  "value": "125009",
                  "type": "text"
                },
                {
                  "key": "customer.phoneNumber",
                  "value": "79161234567",
                  "type": "text"
                },
                {
                  "key": "customer.ssn",
                  "value": "123-45-6789",
                  "type": "text"
                },
                {
                  "key": "customer.username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "customer.password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "repeatedPassword",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Вход по REST",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "c903eedd-2431-502e-94bd-c3277b9dfcd7",
                "type": "text/javascript",
                "exec": [
                  "pm.test('вход выполнен', () => pm.response.to.have.status(200));",
                  "pm.test('клиент по схеме', () => pm.response.to.have.jsonSchema(pb.schemas.customer));",
                  "pm.test('это тот, кого регистрировали', () => {",
                  "  const c = pm.response.json();",
                  "  pm.expect([c.firstName, c.lastName, c.address.city]).to.eql(['Anna', 'Petrova', 'Moscow']);",
                  "});",
                  "pm.collectionVariables.set('customerId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/bank/login/{{username}}/{{password}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "bank",
                "login",
                "{{username}}",
                "{{password}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Первый счёт",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "f267ed6f-b413-5c06-ac4f-ac19a8517aa1",
                "type": "text/javascript",
                "exec": [
                  "const accounts = pm.response.json();",
                  "pm.test('при регистрации открыт один расчётный счёт на $515.50', () => {",
                  "  pm.expect(accounts).to.have.length(1);",
                  "  pm.expect(accounts[0].type).to.eql('CHECKING');",
                  "  pm.expect(pb.cents(accounts[0].balance)).to.eql(51550);",
                  "});",
                  "pm.collectionVariables.set('accountA', accounts[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/bank/customers/{{customerId}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "bank",
                "customers",
                "{{customerId}}",
                "accounts"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Регистрация через HTTP-форму: REST API ParaBank клиентов не создаёт."
    },
    {
      "name": "1. Операции",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "74ff6b7f-cafb-56f6-9310-c54d368eb2b1",
                "type": "text/javascript",
                "exec": [
                  "pm.test('вход выполнен', () => pm.response.to.have.status(200));",
                  "pm.test('тот же клиент, что и в REST', () => {",
                  "  pm.expect(pb.xmlValue('id')).to.eql(String(pm.collectionVariables.get('customerId')));",
                  "  pm.expect(pb.xmlValue('firstName')).to.eql('Anna');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/ParaBank",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "ParaBank"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:par=\"http://service.parabank.parasoft.com/\">\n  <soapenv:Body>\n    <par:login><par:username>{{username}}</par:username><par:password>{{password}}</par:password></par:login>\n  </soapenv:Body>\n</soapenv:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          },
          "response": []
        },
