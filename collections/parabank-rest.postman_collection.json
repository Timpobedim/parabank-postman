    {
      "name": "1. Счета",
      "item": [
        {
          "name": "Открыть сберегательный счёт",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "1c511ce0-eb08-57f8-8cb4-5cf995748224",
                "type": "text/javascript",
                "exec": [
                  "const a = pm.response.json();",
                  "pm.test('счёт по схеме', () => pm.response.to.have.jsonSchema(pb.schemas.account));",
                  "pm.test('сберегательный и принадлежит клиенту', () => {",
                  "  pm.expect(a.type).to.eql('SAVINGS');",
                  "  pm.expect(a.customerId).to.eql(Number(pm.collectionVariables.get('customerId')));",
                  "  pm.expect(a.id).to.not.eql(Number(pm.collectionVariables.get('accountA')));",
                  "});",
                  "pm.collectionVariables.set('accountB', a.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/bank/createAccount?customerId={{customerId}}&newAccountType=1&fromAccountId={{accountA}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "bank",
                "createAccount"
              ],
              "query": [
                {
                  "key": "customerId",
                  "value": "{{customerId}}"
                },
                {
                  "key": "newAccountType",
                  "value": "1"
                },
                {
                  "key": "fromAccountId",
                  "value": "{{accountA}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Счета после открытия",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "b48dc99a-2a2a-561b-8bd6-9da0989b72b5",
                "type": "text/javascript",
                "exec": [
                  "const accounts = pm.response.json();",
                  "const byId = Object.fromEntries(accounts.map((a) => [a.id, a]));",
                  "const a = byId[pm.collectionVariables.get('accountA')];",
                  "const b = byId[pm.collectionVariables.get('accountB')];",
                  "pm.test('список по схеме', () => pm.response.to.have.jsonSchema({ type: 'array', items: pb.schemas.account }));",
                  "pm.test('счетов стало два', () => pm.expect(accounts).to.have.length(2));",
                  "pm.test('на новый счёт переведено $100 с первого', () => {",
                  "  pm.expect(pb.cents(a.balance)).to.eql(51550 - 10000);",
                  "  pm.expect(pb.cents(b.balance)).to.eql(10000);",
                  "});",
                  "pm.collectionVariables.set('balanceA', pb.cents(a.balance));",
                  "pm.collectionVariables.set('balanceB', pb.cents(b.balance));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/bank/customers/{{customerId}}/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "bank",
                "customers",
                "{{customerId}}",
                "accounts"
              ]
            }
          },
          "response": []
        }
      ]
    },
