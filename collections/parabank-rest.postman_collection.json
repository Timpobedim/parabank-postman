              "listen": "test",
              "script": {
                "id": "45c4cf96-e2a8-5047-b2c8-e3b1304a2193",
                "type": "text/javascript",
                "exec": [
                  "pm.test('перевод принят', () => pm.response.to.have.status(200));",
                  "pm.test('ответ называет сумму и оба счёта', () => {",
                  "  const a = pm.collectionVariables.get('accountA'), b = pm.collectionVariables.get('accountB');",
                  "  pm.expect(pm.response.text()).to.eql(`Successfully transferred $25.50 from account #${a} to account #${b}`);",
                  "});",
                  "pm.collectionVariables.set('balanceA', Number(pm.collectionVariables.get('balanceA')) - 2550);",
                  "pm.collectionVariables.set('balanceB', Number(pm.collectionVariables.get('balanceB')) + 2550);"
                ]
