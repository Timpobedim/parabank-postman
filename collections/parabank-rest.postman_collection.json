        {
          "name": "История счёта",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "5b8678ef-46c0-55b6-82db-96efd852affc",
                "type": "text/javascript",
                "exec": [
                  "const tx = pm.response.json();",
                  "pm.test('история по схеме', () => pm.response.to.have.jsonSchema({ type: 'array', items: pb.schemas.transaction }));",
                  "pm.test('в истории четыре операции с верными суммами и знаками', () => {",
                  "  const seen = tx.map((t) => `${t.type} ${pb.cents(t.amount)}`).sort();",
                  "  pm.expect(seen).to.eql(['Credit 1000', 'Credit 10000', 'Credit 2550', 'Debit 500']);",
                  "});",
                  "pm.test('дата операций — сегодня, а не пустая или старая', () => {",
                  "  tx.forEach((t) => pm.expect(Math.abs(t.date - Date.now())).to.be.below(2 * 86400000));",
                  "});",
                  "pm.test('все операции — по этому счёту', () => {",
                  "  tx.forEach((t) => pm.expect(t.accountId).to.eql(Number(pm.collectionVariables.get('accountB'))));",
                  "});"
                ]
              }
            }
